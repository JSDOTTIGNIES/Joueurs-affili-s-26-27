rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == "secretariat@jsdottignies.be";
    }

    match /players/{playerId} {
      allow create: if
        request.resource.data.keys().hasAll([
          "team","fullName","address","email","phone",
          "emergency1","emergency2","certificateGiven",
          "contributionStatus","createdAt","updatedAt"
        ])
        && request.resource.data.contributionStatus == "unpaid";

      allow read, update, delete: if isAdmin();
    }
  }
}
