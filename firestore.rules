rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == "steve.l@dlgroupe.com";
    }

    match /players/{playerId} {
      allow create: if
        request.resource.data.keys().hasAll([
          "team","fullName","address","email","phone",
          "emergency1","emergency2","photoUrl","photoPublicId","certificateGiven",
          "contributionStatus","createdAt","updatedAt"
        ])
        && request.resource.data.photoUrl is string
        && request.resource.data.photoPublicId is string
        && request.resource.data.contributionStatus in [
          "unpaid",
          "paid_partial",
          "paid_total"
        ];

      allow read, update, delete: if isAdmin();
    }
  }
}
